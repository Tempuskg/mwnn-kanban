{
  "name": "mwnn-kanban",
  "displayName": "MWNN Kanban",
  "description": "An in-editor MWNN Kanban board. Pro license validation sends the license key to Polar; no usage, board, or time data is transmitted.",
  "version": "0.0.6",
  "icon": "media/icon.png",
  "publisher": "darrenjmcleod",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tempuskg/mwnn-kanban.git"
  },
  "homepage": "https://github.com/Tempuskg/mwnn-kanban#readme",
  "bugs": {
    "url": "https://github.com/Tempuskg/mwnn-kanban/issues"
  },
  "galleryBanner": {
    "color": "#171717",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "kanban",
    "board",
    "tasks",
    "todo",
    "productivity"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:mwnn-kanban.board"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mwnn-kanban",
          "title": "MWNN Kanban",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "mwnn-kanban": [
        {
          "type": "webview",
          "id": "mwnn-kanban.sidebar",
          "name": "MWNN Kanban",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "mwnn-kanban.openBoard",
        "title": "Open Board",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.addColumn",
        "title": "Add Column",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.renameColumn",
        "title": "Rename Column",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.deleteColumn",
        "title": "Delete Column",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.setColumnLimits",
        "title": "Set Column Limits",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.runCardWithAI",
        "title": "Run Card with AI",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.runBoardLoop",
        "title": "Run Board with AI Loop",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.stopBoardLoop",
        "title": "Stop AI Loop",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.stopCardRun",
        "title": "Stop Card AI Run",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.importPlan",
        "title": "Import Plan",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.resetBoard",
        "title": "Reset Board",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.upgradeToPro",
        "title": "Get MWNN Kanban Pro",
        "category": "MWNN Kanban Pro",
        "icon": "$(star-full)"
      },
      {
        "command": "mwnn-kanban.enterProLicenseKey",
        "title": "Enter Pro License Key",
        "category": "MWNN Kanban Pro"
      },
      {
        "command": "mwnn-kanban.clearProLicenseKey",
        "title": "Clear Pro License Key",
        "category": "MWNN Kanban Pro"
      },
      {
        "command": "mwnn-kanban.showProLicenseStatus",
        "title": "Show Pro License Status",
        "category": "MWNN Kanban Pro"
      }
    ],
    "configuration": {
      "title": "MWNN Kanban",
      "properties": {
        "mwnn-kanban.confirmCardDeletion": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before deleting a card.",
          "scope": "resource"
        },
        "mwnn-kanban.boardFolder": {
          "type": "string",
          "default": ".mwnn",
          "description": "Workspace-relative folder where the Kanban board files are stored.",
          "scope": "resource"
        },
        "mwnn-kanban.defaultReadyReverseWip": {
          "type": "number",
          "default": 3,
          "description": "Minimum number of defined cards the Ready column should keep available by default.",
          "scope": "resource"
        },
        "mwnn-kanban.enableRunWithAI": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI-assisted board actions when those commands are available.",
          "scope": "resource"
        },
        "mwnn-kanban.chatProviderCommands": {
          "type": "object",
          "default": {},
          "description": "Override the VS Code command used to open each AI chat extension for 'Run with AI' handoff. Keys: copilot, codex, claude-code. Leave empty to use the built-in defaults.",
          "properties": {
            "copilot": {
              "type": "string"
            },
            "codex": {
              "type": "string"
            },
            "claude-code": {
              "type": "string"
            }
          },
          "scope": "resource"
        },
        "mwnn-kanban.aiLoopProvider": {
          "type": "string",
          "enum": [
            "prompt",
            "chat",
            "copilot",
            "codex",
            "claude-code",
            "cursor"
          ],
          "enumDescriptions": [
            "Ask whether to use a VS Code chat extension or a local agent CLI.",
            "Run the loop through an installed VS Code AI chat extension.",
            "Run the loop with GitHub Copilot CLI.",
            "Run the loop with OpenAI Codex CLI.",
            "Run the loop with Anthropic Claude Code CLI.",
            "Run the loop with Cursor Agent CLI."
          ],
          "default": "prompt",
          "description": "AI execution channel or provider used by the AI board loop.",
          "scope": "resource"
        },
        "mwnn-kanban.aiLoopReviewFreshDefinitions": {
          "type": "boolean",
          "default": false,
          "description": "Pause cards the AI board loop has just defined in the Ready column until the next run, so a human can review the fresh Description and Acceptance criteria first. When off, the loop continues and implements freshly defined cards in the same run.",
          "scope": "resource"
        },
        "mwnn-kanban.aiLoopVerifyCards": {
          "type": "boolean",
          "default": false,
          "description": "Let the AI board loop verify cards in the Verify column and move them to Done when every acceptance criterion is confirmed, handing anything it cannot confirm back to a human. When off, every card reaching Verify is assigned to a human for verification.",
          "scope": "resource"
        },
        "mwnn-kanban.agentCliPaths": {
          "type": "object",
          "default": {},
          "description": "Optional executable path overrides for the agent CLIs used by 'Run Card with AI' and the AI board loop. Values are executable paths only (not shell command lines), and paths containing spaces are supported.",
          "properties": {
            "copilot": {
              "type": "string",
              "description": "Path to the GitHub Copilot CLI executable."
            },
            "codex": {
              "type": "string",
              "description": "Path to the OpenAI Codex CLI executable."
            },
            "claude-code": {
              "type": "string",
              "description": "Path to the Anthropic Claude Code CLI executable."
            },
            "cursor": {
              "type": "string",
              "description": "Path to the Cursor Agent CLI executable."
            }
          },
          "scope": "resource"
        },
        "mwnn-kanban.defaultColumns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Backlog",
            "Ready",
            "In Progress",
            "Verify",
            "Done"
          ],
          "description": "Column titles used when a board is first created or reset. Roles are inferred from these titles, and the default set includes a Ready column for reverse-WIP tracking.",
          "scope": "resource"
        },
        "mwnn-kanban-pro.polar.organizationId": {
          "type": "string",
          "default": "",
          "description": "Polar organization id used to validate MWNN Kanban Pro license keys.",
          "scope": "application"
        },
        "mwnn-kanban-pro.polar.apiBaseUrl": {
          "type": "string",
          "default": "https://api.polar.sh",
          "description": "Polar API base URL used for MWNN Kanban Pro license validation. Change this only when testing against a Polar sandbox.",
          "scope": "application"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "mwnn-kanban.openBoard"
        },
        {
          "command": "mwnn-kanban.addColumn"
        },
        {
          "command": "mwnn-kanban.renameColumn"
        },
        {
          "command": "mwnn-kanban.deleteColumn"
        },
        {
          "command": "mwnn-kanban.setColumnLimits"
        },
        {
          "command": "mwnn-kanban.runCardWithAI",
          "when": "config.mwnn-kanban.enableRunWithAI"
        },
        {
          "command": "mwnn-kanban.runBoardLoop",
          "when": "config.mwnn-kanban.enableRunWithAI"
        },
        {
          "command": "mwnn-kanban.stopBoardLoop",
          "when": "config.mwnn-kanban.enableRunWithAI"
        },
        {
          "command": "mwnn-kanban.stopCardRun",
          "when": "config.mwnn-kanban.enableRunWithAI"
        },
        {
          "command": "mwnn-kanban.importPlan",
          "when": "config.mwnn-kanban.enableRunWithAI"
        },
        {
          "command": "mwnn-kanban.resetBoard"
        },
        {
          "command": "mwnn-kanban.upgradeToPro",
          "when": "!mwnn-kanban.hasProLicense"
        },
        {
          "command": "mwnn-kanban.enterProLicenseKey"
        },
        {
          "command": "mwnn-kanban.clearProLicenseKey"
        },
        {
          "command": "mwnn-kanban.showProLicenseStatus"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:production",
    "compile": "webpack",
    "watch": "webpack --watch",
    "build:production": "webpack --mode production --devtool hidden-source-map",
    "package": "npm run build:production",
    "package:vsix": "npx --yes @vscode/vsce package --out mwnn-kanban.vsix",
    "build:pro-stub": "tsc -p mwnn-kanban-pro/tsconfig.json",
    "prelink:pro-stub": "npm run build:pro-stub",
    "link:pro-stub": "npm link ./mwnn-kanban-pro --no-save --no-audit --no-fund",
    "compile-tests": "tsc -p tsconfig.test.json",
    "watch-tests": "tsc -p tsconfig.test.json --watch",
    "pretest": "npm run compile-tests",
    "test": "node ./scripts/run-unit-tests.cjs",
    "presmoke:agent-cli": "npm run compile-tests",
    "smoke:agent-cli": "node ./scripts/smoke-agent-cli.cjs",
    "version:build": "node ./scripts/bump-package-version.cjs",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.29.0",
    "webpack": "^5.97.0",
    "webpack-cli": "^5.1.4"
  }
}
