{
  "name": "mwnn-kanban",
  "displayName": "MWNN Kanban",
  "description": "An in-editor MWNN Kanban board. Pro license validation sends the license key to Polar; no usage, board, or time data is transmitted.",
  "version": "0.0.6",
  "icon": "media/icon.png",
  "publisher": "darrenjmcleod",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tempuskg/mwnn-kanban.git"
  },
  "homepage": "https://github.com/Tempuskg/mwnn-kanban#readme",
  "bugs": {
    "url": "https://github.com/Tempuskg/mwnn-kanban/issues"
  },
  "galleryBanner": {
    "color": "#171717",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "kanban",
    "board",
    "tasks",
    "todo",
    "productivity"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:mwnn-kanban.board"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mwnn-kanban",
          "title": "MWNN Kanban",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "mwnn-kanban": [
        {
          "type": "webview",
          "id": "mwnn-kanban.sidebar",
          "name": "MWNN Kanban",
          "icon": "media/sidebar-icon.svg"
        },
        {
          "type": "tree",
          "id": "mwnn-kanban.myWork",
          "name": "My Work",
          "when": "mwnn-kanban.hasProLicense",
          "icon": "$(checklist)"
        }
      ]
    },
    "commands": [
      {
        "command": "mwnn-kanban.openBoard",
        "title": "Open Board",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.addColumn",
        "title": "Add Column",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.renameColumn",
        "title": "Rename Column",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.deleteColumn",
        "title": "Delete Column",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.setColumnLimits",
        "title": "Set Column Limits",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.runCardWithAI",
        "title": "Run Card with AI",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.runBoardLoop",
        "title": "Run Board with AI Loop",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.stopBoardLoop",
        "title": "Stop AI Loop",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.stopCardRun",
        "title": "Stop Card AI Run",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.importPlan",
        "title": "Import Plan",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.resetBoard",
        "title": "Reset Board",
        "category": "MWNN Kanban"
      },
      {
        "command": "mwnn-kanban.upgradeToPro",
        "title": "Get MWNN Kanban Pro",
        "category": "MWNN Kanban Pro",
        "icon": "$(star-full)"
      },
      {
        "command": "mwnn-kanban.enterProLicenseKey",
        "title": "Enter Pro License Key",
        "category": "MWNN Kanban Pro"
      },
      {
        "command": "mwnn-kanban.clearProLicenseKey",
        "title": "Clear Pro License Key",
        "category": "MWNN Kanban Pro"
      },
      {
        "command": "mwnn-kanban.showProLicenseStatus",
        "title": "Show Pro License Status",
        "category": "MWNN Kanban Pro"
      },
      {
        "command": "mwnn-kanban-pro.hello",
        "title": "Hello from MWNN Kanban Pro",
        "category": "MWNN Kanban Pro"
      },
      {
        "command": "mwnn-kanban-pro.openPortfolio",
        "title": "Open Portfolio",
        "category": "MWNN Kanban Pro",
        "icon": "$(graph)"
      },
      {
        "command": "mwnn-kanban-pro.rescanProjects",
        "title": "Rescan Projects",
        "category": "MWNN Kanban Pro",
        "icon": "$(refresh)"
      },
      {
        "command": "mwnn-kanban-pro.startTimer",
        "title": "Start Timer",
        "category": "MWNN Kanban Pro",
        "icon": "$(play)"
      },
      {
        "command": "mwnn-kanban-pro.stopTimer",
        "title": "Stop Timer",
        "category": "MWNN Kanban Pro",
        "icon": "$(debug-stop)"
      },
      {
        "command": "mwnn-kanban-pro.correctLastSession",
        "title": "Correct Last Session",
        "category": "MWNN Kanban Pro"
      },
      {
        "command": "mwnn-kanban-pro.exportTimesheet",
        "title": "Export Timesheet",
        "category": "MWNN Kanban Pro",
        "icon": "$(export)"
      },
      {
        "command": "mwnn-kanban-pro.startFocusSession",
        "title": "Start Focus Session",
        "category": "MWNN Kanban Pro",
        "icon": "$(target)"
      },
      {
        "command": "mwnn-kanban-pro.stopFocusSession",
        "title": "Stop Focus Session",
        "category": "MWNN Kanban Pro"
      },
      {
        "command": "mwnn-kanban-pro.setAllocationTargets",
        "title": "Set Allocation Targets",
        "category": "MWNN Kanban Pro",
        "icon": "$(settings-gear)"
      }
    ],
    "configuration": {
      "title": "MWNN Kanban",
      "properties": {
        "mwnn-kanban.confirmCardDeletion": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before deleting a card.",
          "scope": "resource"
        },
        "mwnn-kanban.boardFolder": {
          "type": "string",
          "default": ".mwnn",
          "description": "Workspace-relative folder where the Kanban board files are stored.",
          "scope": "resource"
        },
        "mwnn-kanban.defaultReadyReverseWip": {
          "type": "number",
          "default": 3,
          "description": "Minimum number of defined cards the Ready column should keep available by default.",
          "scope": "resource"
        },
        "mwnn-kanban.enableRunWithAI": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI-assisted board actions when those commands are available.",
          "scope": "resource"
        },
        "mwnn-kanban.chatProviderCommands": {
          "type": "object",
          "default": {},
          "description": "Override the VS Code command used to open each AI chat extension for 'Run with AI' handoff. Keys: copilot, codex, claude-code. Leave empty to use the built-in defaults.",
          "properties": {
            "copilot": {
              "type": "string"
            },
            "codex": {
              "type": "string"
            },
            "claude-code": {
              "type": "string"
            }
          },
          "scope": "resource"
        },
        "mwnn-kanban.aiLoopProvider": {
          "type": "string",
          "enum": [
            "prompt",
            "chat",
            "copilot",
            "codex",
            "claude-code",
            "cursor"
          ],
          "enumDescriptions": [
            "Ask whether to use a VS Code chat extension or a local agent CLI.",
            "Run the loop through an installed VS Code AI chat extension.",
            "Run the loop with GitHub Copilot CLI.",
            "Run the loop with OpenAI Codex CLI.",
            "Run the loop with Anthropic Claude Code CLI.",
            "Run the loop with Cursor Agent CLI."
          ],
          "default": "prompt",
          "description": "AI execution channel or provider used by the AI board loop.",
          "scope": "resource"
        },
        "mwnn-kanban.aiLoopReviewFreshDefinitions": {
          "type": "boolean",
          "default": false,
          "description": "Pause cards the AI board loop has just defined in the Ready column until the next run, so a human can review the fresh Description and Acceptance criteria first. When off, the loop continues and implements freshly defined cards in the same run.",
          "scope": "resource"
        },
        "mwnn-kanban.aiLoopVerifyCards": {
          "type": "boolean",
          "default": false,
          "description": "Let the AI board loop verify cards in the Verify column and move them to Done when every acceptance criterion is confirmed, handing anything it cannot confirm back to a human. When off, every card reaching Verify is assigned to a human for verification.",
          "scope": "resource"
        },
        "mwnn-kanban.agentCliPaths": {
          "type": "object",
          "default": {},
          "description": "Optional executable path overrides for the agent CLIs used by 'Run Card with AI' and the AI board loop. Values are executable paths only (not shell command lines), and paths containing spaces are supported.",
          "properties": {
            "copilot": {
              "type": "string",
              "description": "Path to the GitHub Copilot CLI executable."
            },
            "codex": {
              "type": "string",
              "description": "Path to the OpenAI Codex CLI executable."
            },
            "claude-code": {
              "type": "string",
              "description": "Path to the Anthropic Claude Code CLI executable."
            },
            "cursor": {
              "type": "string",
              "description": "Path to the Cursor Agent CLI executable."
            }
          },
          "scope": "resource"
        },
        "mwnn-kanban.defaultColumns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Backlog",
            "Ready",
            "In Progress",
            "Verify",
            "Done"
          ],
          "description": "Column titles used when a board is first created or reset. Roles are inferred from these titles, and the default set includes a Ready column for reverse-WIP tracking.",
          "scope": "resource"
        },
        "mwnn-kanban-pro.polar.organizationId": {
          "type": "string",
          "default": "9a3f3f03-1384-425b-8a7a-54866b7d634a",
          "description": "Polar organization id used to validate MWNN Kanban Pro license keys.",
          "scope": "application"
        },
        "mwnn-kanban-pro.polar.benefitId": {
          "type": "string",
          "default": "",
          "description": "Polar License Keys benefit id required for MWNN Kanban Pro license validation. Leave empty only for sandbox testing without a configured benefit.",
          "scope": "application"
        },
        "mwnn-kanban-pro.polar.apiBaseUrl": {
          "type": "string",
          "default": "https://api.polar.sh",
          "description": "Polar API base URL used for MWNN Kanban Pro license validation. Change this only when testing against a Polar sandbox.",
          "scope": "application"
        },
        "mwnn-kanban-pro.heartbeatSeconds": {
          "type": "number",
          "default": 30,
          "description": "Seconds between automatic activity heartbeats.",
          "scope": "application"
        },
        "mwnn-kanban-pro.idleTimeoutMinutes": {
          "type": "number",
          "default": 5,
          "description": "Minutes without tracked activity before an automatic session closes.",
          "scope": "application"
        },
        "mwnn-kanban-pro.minSessionMinutes": {
          "type": "number",
          "default": 1,
          "description": "Minimum duration in minutes for a tracked session to be persisted.",
          "scope": "application"
        },
        "mwnn-kanban-pro.maxSliceMinutes": {
          "type": "number",
          "default": 5,
          "description": "Maximum minutes in one persisted time slice before a checkpoint is written.",
          "scope": "application"
        },
        "mwnn-kanban-pro.trackWhenUnfocused": {
          "type": "boolean",
          "default": false,
          "description": "Continue automatic activity tracking while the VS Code window is unfocused.",
          "scope": "application"
        },
        "mwnn-kanban-pro.manualTimerSuppressesAutomatic": {
          "type": "boolean",
          "default": true,
          "description": "Suppress automatic slices while a manual timer is running.",
          "scope": "application"
        },
        "mwnn-kanban-pro.autoRegisterProjects": {
          "type": "boolean",
          "default": true,
          "description": "Automatically register workspace projects that contain a Kanban board.",
          "scope": "application"
        },
        "mwnn-kanban-pro.projectRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Machine-local roots to scan for Kanban projects.",
          "scope": "machine"
        },
        "mwnn-kanban-pro.scanDepth": {
          "type": "number",
          "default": 2,
          "description": "Maximum directory depth when scanning configured project roots.",
          "scope": "machine"
        },
        "mwnn-kanban-pro.scanIgnore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Machine-local directory names or paths to skip during project scans.",
          "scope": "machine"
        },
        "mwnn-kanban-pro.allocationWindowDays": {
          "type": "number",
          "default": 7,
          "description": "Number of days included in allocation and drift calculations.",
          "scope": "application"
        },
        "mwnn-kanban-pro.minTrackedHoursForDrift": {
          "type": "number",
          "default": 2,
          "description": "Minimum tracked hours required before drift and debt are considered reliable.",
          "scope": "application"
        },
        "mwnn-kanban-pro.outputWindowDays": {
          "type": "number",
          "default": 30,
          "description": "Number of days included in Output and throughput calculations.",
          "scope": "application"
        },
        "mwnn-kanban-pro.focusSessionMinutes": {
          "type": "number",
          "default": 25,
          "description": "Length in minutes of a focus session.",
          "scope": "application"
        },
        "mwnn-kanban-pro.focusBreakMinutes": {
          "type": "number",
          "default": 5,
          "description": "Length in minutes of the break offered after a focus session.",
          "scope": "application"
        },
        "mwnn-kanban-pro.driftNudges": {
          "type": "boolean",
          "default": true,
          "description": "Show occasional nudges when allocation drift is actionable.",
          "scope": "application"
        },
        "mwnn-kanban-pro.nudgeThresholdPercent": {
          "type": "number",
          "default": 10,
          "description": "Absolute drift percentage-point threshold before a nudge can appear.",
          "scope": "application"
        },
        "mwnn-kanban-pro.nudgeCooldownHours": {
          "type": "number",
          "default": 4,
          "description": "Minimum hours between allocation drift nudges.",
          "scope": "application"
        },
        "mwnn-kanban-pro.queueDepth": {
          "type": "number",
          "default": 10,
          "description": "Maximum number of cards shown in the unified My Work queue.",
          "scope": "application"
        },
        "mwnn-kanban-pro.backfillFromActivity": {
          "type": "boolean",
          "default": false,
          "description": "Include eligible historical card activity when building flow metrics.",
          "scope": "application"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "mwnn-kanban.openBoard"
        },
        {
          "command": "mwnn-kanban.addColumn"
        },
        {
          "command": "mwnn-kanban.renameColumn"
        },
        {
          "command": "mwnn-kanban.deleteColumn"
        },
        {
          "command": "mwnn-kanban.setColumnLimits"
        },
        {
          "command": "mwnn-kanban.runCardWithAI",
          "when": "config.mwnn-kanban.enableRunWithAI"
        },
        {
          "command": "mwnn-kanban.runBoardLoop",
          "when": "config.mwnn-kanban.enableRunWithAI"
        },
        {
          "command": "mwnn-kanban.stopBoardLoop",
          "when": "config.mwnn-kanban.enableRunWithAI"
        },
        {
          "command": "mwnn-kanban.stopCardRun",
          "when": "config.mwnn-kanban.enableRunWithAI"
        },
        {
          "command": "mwnn-kanban.importPlan",
          "when": "config.mwnn-kanban.enableRunWithAI"
        },
        {
          "command": "mwnn-kanban.resetBoard"
        },
        {
          "command": "mwnn-kanban.upgradeToPro",
          "when": "!mwnn-kanban.hasProLicense"
        },
        {
          "command": "mwnn-kanban.enterProLicenseKey"
        },
        {
          "command": "mwnn-kanban.clearProLicenseKey"
        },
        {
          "command": "mwnn-kanban.showProLicenseStatus"
        },
        {
          "command": "mwnn-kanban-pro.hello",
          "when": "mwnn-kanban.hasProLicense"
        },
        {
          "command": "mwnn-kanban-pro.openPortfolio",
          "when": "mwnn-kanban.hasProLicense"
        },
        {
          "command": "mwnn-kanban-pro.rescanProjects",
          "when": "mwnn-kanban.hasProLicense"
        },
        {
          "command": "mwnn-kanban-pro.startTimer",
          "when": "mwnn-kanban.hasProLicense"
        },
        {
          "command": "mwnn-kanban-pro.stopTimer",
          "when": "mwnn-kanban.hasProLicense"
        },
        {
          "command": "mwnn-kanban-pro.correctLastSession",
          "when": "mwnn-kanban.hasProLicense"
        },
        {
          "command": "mwnn-kanban-pro.exportTimesheet",
          "when": "mwnn-kanban.hasProLicense"
        },
        {
          "command": "mwnn-kanban-pro.startFocusSession",
          "when": "mwnn-kanban.hasProLicense"
        },
        {
          "command": "mwnn-kanban-pro.stopFocusSession",
          "when": "mwnn-kanban.hasProLicense"
        },
        {
          "command": "mwnn-kanban-pro.setAllocationTargets",
          "when": "mwnn-kanban.hasProLicense"
        }
      ],
      "view/title": [
        {
          "command": "mwnn-kanban-pro.openPortfolio",
          "when": "view == mwnn-kanban.myWork && mwnn-kanban.hasProLicense",
          "group": "navigation@1"
        },
        {
          "command": "mwnn-kanban-pro.rescanProjects",
          "when": "view == mwnn-kanban.myWork && mwnn-kanban.hasProLicense",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "mwnn-kanban-pro.startTimer",
          "when": "view == mwnn-kanban.myWork && viewItem == mwnn-kanban.card && mwnn-kanban.hasProLicense",
          "group": "inline@1"
        },
        {
          "command": "mwnn-kanban-pro.stopTimer",
          "when": "view == mwnn-kanban.myWork && viewItem == mwnn-kanban.card && mwnn-kanban.hasProLicense",
          "group": "inline@2"
        },
        {
          "command": "mwnn-kanban-pro.startFocusSession",
          "when": "view == mwnn-kanban.myWork && viewItem == mwnn-kanban.card && mwnn-kanban.hasProLicense",
          "group": "inline@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:production",
    "compile": "webpack",
    "watch": "webpack --watch",
    "build:production": "webpack --mode production --devtool hidden-source-map",
    "package": "npm run build:production",
    "package:vsix": "npx --yes @vscode/vsce package --out mwnn-kanban.vsix",
    "build:pro-stub": "tsc -p mwnn-kanban-pro/tsconfig.json",
    "prelink:pro-stub": "npm run build:pro-stub",
    "link:pro-stub": "npm link ./mwnn-kanban-pro --no-save --no-audit --no-fund",
    "compile-tests": "tsc -p tsconfig.test.json",
    "watch-tests": "tsc -p tsconfig.test.json --watch",
    "pretest": "npm run compile-tests",
    "test": "node ./scripts/run-unit-tests.cjs",
    "presmoke:agent-cli": "npm run compile-tests",
    "smoke:agent-cli": "node ./scripts/smoke-agent-cli.cjs",
    "version:build": "node ./scripts/bump-package-version.cjs",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "@tempuskg/mwnn-kanban-pro": "0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.29.0",
    "webpack": "^5.97.0",
    "webpack-cli": "^5.1.4"
  }
}
